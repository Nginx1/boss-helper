{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.6.0",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "64": "icons/64.png",
    "128": "icons/128.png",
    "256": "icons/256.png"
  },
  "default_locale": "zh_CN",
  "permissions": [
    "storage",
    "cookies",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "boss.js"
      ],
      "matches": [
        "*://zhipin.com/*",
        "*://*.zhipin.com/*"
      ]
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.zhipin.com/*",
        "*://zhipin.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "content-scripts/content.css"
      ],
      "js": [
        "content-scripts/content.js"
      ],
      "world": "ISOLATED"
    }
  ],
  "version_name": "0.6.0 · 我的维护版",
  "homepage_url": "https://github.com/Nginx1/boss-helper"
}
